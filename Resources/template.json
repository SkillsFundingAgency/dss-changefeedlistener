{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appInsightsInstrumentationKey": {
      "type": "string"
    },
    "functionAppPrefix": {
      "type": "string",
      "metadata": {
        "description": "Prefix for the function app resources, in the form dfc-env-proj-fnapp"
      }
    },
    "functionAppSuffix": {
      "type": "string",
      "metadata": {
        "description": "Suffix for the function app resources, in the form version number"
      }
    },
    "searchServiceName": {
      "type": "string"
    },
    "searchServiceAdminApiKey": {
      "type": "securestring"
    },
    "storageConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for the storage account to store function app files"
      }
    },
    "serviceBusConnectionString": {
      "type": "securestring"
    },
    "cosmosDBEndpoint": {
      "type": "securestring"
    },
    "keyVaultName": {
      "type": "string"
    }
  },
  "variables": {
    "functionAppName": "[concat(parameters('functionAppPrefix'),'-fa', parameters('functionAppSuffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', variables('functionAppName'), 'appsettings')]",
        "properties": {
            "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('appInsightsInstrumentationKey')]",
            "FUNCTIONS_EXTENSION_VERSION": "~4",
            "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
            "MSDEPLOY_RENAME_LOCKED_FILES": "1",
            "AzureWebJobsStorage": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=SharedStorageAccountConnectionString)', parameters('keyVaultName'))]",
            "ActionPlanCollectionId": "actionplans",
            "ActionPlanDatabaseId": "actionplans",
            "ActionPlanLeaseCollectionName": "actionplans-lease",
            "ActionPlanLeaseCollectionPrefix": "ActionPlanChangeFeedPrefix",
            "ActionCollectionId": "actions",
            "ActionDatabaseId": "actions",
            "ActionLeaseCollectionName": "actions-lease",
            "ActionLeaseCollectionPrefix": "ActionChangeFeedPrefix",
            "AddressCollectionId": "addresses",
            "AddressDatabaseId": "addresses",
            "AddressLeaseCollectionName": "addresses-lease",
            "AddressLeaseCollectionPrefix": "AddressChangeFeedPrefix",
            "AdviserDetailCollectionId": "adviserdetails",
            "AdviserDetailDatabaseId": "adviserdetails",
            "AdviserDetailLeaseCollectionName": "adviserdetails-lease",
            "AdviserDetailLeaseCollectionPrefix": "AdviserDetailChangeFeedPrefix",
            "ContactCollectionId": "contacts",
            "ContactDatabaseId": "contacts",
            "ContactLeaseCollectionName": "contact-lease",
            "ContactLeaseCollectionPrefix": "ContactChangeFeedPrefix",
            "CustomerCollectionId": "customers",
            "CustomerDatabaseId": "customers",
            "CustomerLeaseCollectionName": "customers-lease",
            "CustomerLeaseCollectionPrefix": "CustomerChangeFeedPrefix",
            "DataCollectionsCollectionId": "collections",
            "DataCollectionsDatabaseId": "collections",
            "DataCollectionsLeaseCollectionName": "collections-lease",
            "DataCollectionsLeaseCollectionPrefix": "CollectionChangeFeedPrefix",
            "DiversityCollectionId": "diversitydetails",
            "DiversityDatabaseId": "diversitydetails",
            "DiversityLeaseCollectionName": "diversity-lease",
            "DiversityLeaseCollectionPrefix": "DiversityChangeFeedPrefix",
            "EmploymentProgressionCollectionId": "employmentprogressions",
            "EmploymentProgressionDatabaseId": "employmentprogressions",
            "EmploymentProgressionLeaseCollectionName": "employmentprogressions-lease",
            "EmploymentProgressionLeaseCollectionPrefix": "EmploymentProgressionChangeFeedPrefix",
            "GoalCollectionId": "goals",
            "GoalDatabaseId": "goals",
            "GoalLeaseCollectionName": "goals-lease",
            "GoalLeaseCollectionPrefix": "GoalChangeFeedPrefix",
            "InteractionCollectionId": "interactions",
            "InteractionDatabaseId": "interactions",
            "InteractionLeaseCollectionName": "interaction-lease",
            "InteractionLeaseCollectionPrefix": "InteractionChangeFeedPrefix",
            "LearningProgressionCollectionId": "learningprogressions",
            "LearningProgressionDatabaseId": "learningprogressions",
            "LearningProgressionLeaseCollectionName": "learningprogressions-lease",
            "LearningProgressionLeaseCollectionPrefix": "LearningProgressionChangeFeedPrefix",
            "OutcomeCollectionId": "outcomes",
            "OutcomeDatabaseId": "outcomes",
            "OutcomeLeaseCollectionName": "outcomes-lease",
            "OutcomeLeaseCollectionPrefix": "OutcomesChangeFeedPrefix",
            "SessionCollectionId": "sessions",
            "SessionDatabaseId": "sessions",
            "SessionLeaseCollectionName": "sessions-lease",
            "SessionLeaseCollectionPrefix": "SessionChangeFeedPrefix",
            "SubscriptionCollectionId": "subscriptions",
            "SubscriptionDatabaseId": "subscriptions",
            "SubscriptionLeaseCollectionName": "subscription-lease",
            "SubscriptionLeaseCollectionPrefix": "SubscriptionChangeFeedPrefix",
            "TransferCollectionId": "transfers",
            "TransferDatabaseId": "transfers",
            "TransferLeaseCollectionName": "transfer-lease",
            "TransferLeaseCollectionPrefix": "TransferChangeFeedPrefix",
            "WebChatCollectionId": "webchats",
            "WebChatDatabaseId": "webchats",
            "WebChatLeaseCollectionName": "WebChat-lease",
            "WebChatLeaseCollectionPrefix": "WebChatChangeFeedPrefix",
            "ChangeFeedQueueName": "dss.changefeedqueue",
            "ServiceBusConnectionString": "[parameters('serviceBusConnectionString')]",
            "CosmosDB__accountEndpoint": "[parameters('cosmosDBEndpoint')]",
            "CosmosDB__credential": "managedidentity",
            "CustomerSearchIndexName": "customer-search-index",
            "CustomerSearchIndexNameV2": "customer-search-index-v2",
            "SearchServiceName": "[parameters('searchServiceName')]",
            "SearchServiceAdminApiKey": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=SharedSearchAdminKey)', parameters('keyVaultName'))]"
        }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', variables('functionAppName'), 'connectionstrings')]",
      "properties": {}
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },

    "appInsightInstrumentationKey": {
      "type": "string",
      "value": "[parameters('appInsightsInstrumentationKey')]"
    }
  }
}
